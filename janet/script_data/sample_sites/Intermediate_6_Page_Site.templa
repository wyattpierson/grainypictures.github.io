<Genesis:File name="index.html">

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
	<title>%st%</title>
	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
	<link rel="stylesheet" type="text/css" href="style.css" media="all" />
</head>
<body background="%p1bg%">
<div align="left">
  <table border="0" cellpadding="5" cellspacing="0" width="%tw%">
    <tr>
      <td colspan="2" align="center">
        <h1>%st%</h1>
        <h2>%p1%</h2>
      </td>
    </tr>
    <tr>
      <td valign="top" nowrap>
        <a href="index.html">%m1%</a><br>
        <a href="page2.html">%m2%</a><br>
        <a href="page3.html">%m3%</a><br>
        <a href="page4.html">%m4%</a><br>
        <a href="page5.html">%m5%</a><br>
        <a href="page6.html">%m6%</a><br>
</td>
      <td valign="top">
        <p align="%pta1a%"><b>%pt1a%</b></p>
        %pr1a%
        <p align="%pta1b%"><b>%pt1b%</b></p>
        %pr1b%
        <p align="%pta1c%"><b>%pt1c%</b></p>
        %pr1c%<br>
        <p align="center"><a href="mailto:%shared_email%">%emlink%</a></p></td>
    </tr>
  </table>
</body>
</html>

</Genesis:File>
_____________________________________________________________________________

