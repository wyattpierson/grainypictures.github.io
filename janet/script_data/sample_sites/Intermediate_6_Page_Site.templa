<Genesis:UserInput>

# Create an HTML form that will be shown to the user.  Be sure to properly
# close all HTML tags.  The following names are reserved for use by Genesis;
# don't create name-value pairs with them: "Action"; "sa"; "Template"; "CWD"

<p><b>Intermediate 6 Page Site</b></p>

This form will allow you to create a 6 page website.<br>
Simply fill out the form and the program will create your site for you.<br>
You can return and edit your site at any time.<br>
Fill out the form below, and then click "Build Web Site".

<ul>
  <li><font size="2">Leave the Menu Link Name blank to remove the page from the
    menu</font></li>
  <li><font size="2">You do not have to use all 6 pages</font></li>
  <li><font size="2">You do not have to use Paragraph Title</font></li>
  <li><font size="2">You do not have to use every Paragraph</font></li>
  <li><font size="2">Although recommended, you do not have to use Page Title</font></li>
</ul>

<input type="hidden" name="tw" value="620">
<input type="hidden" name="emlink" value="Email">

<table border="0" cellpadding="0" cellspacing="0" width="450">
      <tr>
        <td nowrap="nowrap" valign="top" colspan="2"><b>Site Information</b></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">Web Site Title</td>
        <td><input name="st" size="20"></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">Email Address</td>
        <td><input name="shared_email" size="20"></td>
      </tr>

<!---  Start of 1st page  --->
      <tr>
        <td nowrap="nowrap" valign="top">&nbsp;</td>
        <td></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top" colspan="2"><hr></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">&nbsp;</td>
        <td></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top" colspan="2"><b>Page Information</b></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top"><font color="#0000FF"><b>Page #1</b></font></td>
        <td></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">Menu Link Name&nbsp; </td>
        <td><input name="m1" size="20"></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">Page Background</td>
        <td><input name="p1bg" size="35"><font size="2">(url or file
          name)</font></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">Page Title&nbsp; </td>
        <td><input name="p1" size="20"></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">1st Paragraph Title</td>
        <td><input name="pt1a" size="20"> Align <select name="pta1a">
            <option value="left">Left
            <option value="center">Center
            <option value="right">Right
          </select></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">1st Paragraph</td>
        <td><textarea rows="4" name="pr1a" cols="40" wrap="virtual"></textarea></td>
      </tr>
      <tr>
        <td nowrap="nowrap" valign="top">&nbsp;</td>
        <td></td>
      </tr>
    <tr>
      <td nowrap="nowrap" valign="top">2nd Paragraph Title</td>
      <td><input name="pt1b" size="20"> Align <select size="1" name="pta1b">
          <option>Left</option>
          <option>Center</option>
          <option>Right</option>
