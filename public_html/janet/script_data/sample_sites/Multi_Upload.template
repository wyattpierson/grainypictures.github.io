<p><b>Multi Upload</b></p>

<p>This template demonstrates multiple file uploads.</p>

<table border="0">
<tr>
	<td align="right"><b>File 1:</b></td>
	<td><input name="f1_filename" /> <i>URL or existing filename</i></td>
</tr>
<tr>
	<td><br></td>
	<td><input name="f1" type="file" /> <i>Upload new file</i></td>
</tr>

<tr>
	<td align="right"><b>File 2:</b></td>
	<td><input name="f2_filename" /> <i>URL or existing filename</i></td>
</tr>
<tr>
	<td><br></td>
	<td><input name="f2" type="file" /> <i>Upload new file</i></td>
</tr>

<tr>
	<td align="right"><b>File 3:</b></td>
	<td><input name="f3_filename" /> <i>URL or existing filename</i></td>
</tr>
<tr>
	<td><br></td>
	<td><input name="f3" type="file" /> <i>Upload new file</i></td>
</tr>

<tr>
	<td align="right"><b>File 4:</b></td>
	<td><input name="f4_filename" /> <i>URL or existing filename</i></td>
</tr>
<tr>
	<td><br></td>
	<td><input name="f4" type="file" /> <i>Upload new file</i></td>
</tr>
</table>

</Genesis:UserInput>
