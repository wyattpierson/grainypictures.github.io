<Genesis:File name="images.html">

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html>
<head>
	<title>Multiple Files</title>
	<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
	<link rel="stylesheet" type="text/css" href="style.css" media="all" />
</head>
<body>

<p><b>File 1</b></p>

<% if f1_filename %>

	<p><img src="%f1_filename%" /></p>

<% end if %>
<% if not f1_filename %>

	<p>No image uploaded.</p>

<% end if %>


<p><b>File 2</b></p>

<% if f2_filename %>

	<p><img src="%f2_filename%" /></p>

<% end if %>
<% if not f2_filename %>

	<p>No image uploaded.</p>

<% end if %>


<p><b>File 3</b></p>

<% if f3_filename %>

	<p><img src="%f3_filename%" /></p>

<% end if %>
<% if not f3_filename %>

	<p>No image uploaded.</p>

<% end if %>


<p><b>File 4</b></p>

<% if f4_filename %>

	<p><img src="%f4_filename%" /></p>

<% end if %>
<% if not f4_filename %>

	<p>No image uploaded.</p>

<% end if %>

</body>
</html>

</Genesis:File>
